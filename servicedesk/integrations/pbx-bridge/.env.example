# pbx-bridge: TODAS as opções. Copie para um arquivo fora do git (chmod 600). Nunca commite valores reais.
# false = não processa nada (webhook responde 503, poller parado)
ENABLED=false
CHATWOOT_URL=http://servicedesk_rails:3000
# token do usuário "Integração 55PBX" (provision_55pbx.rb)
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=1
# id da inbox "Telefone (55PBX)"
PBX_INBOX_ID=
# id do usuário de integração (ignora as próprias notas no gatilho de atribuição)
INTEGRATION_USER_ID=
# >= 32 caracteres: openssl rand -hex 32
WEBHOOK_SECRET=
# "secret" da inbox API (assinatura X-Chatwoot-Signature), opcional
CHATWOOT_WEBHOOK_HMAC_SECRET=
PBX_API_URL=https://reportapi02.55pbx.com:50500/api/pbx/reports/metrics
# chave do painel 55PBX (Integrações > Webservice (API))
PBX_API_KEY=
# nome do header: CONFIRMAR com suporte@55pbx.com.br
PBX_API_KEY_HEADER=key
PBX_TZ_OFFSET=-3
POLL_INTERVAL_MIN=10
POLL_LOOKBACK_MIN=180
# JSON {"3855-FILA_SUPORTE_1":"Suporte"} ou "fila=time;fila=time" (vazio = padrão)
QUEUE_TEAM_MAP=
# {"5005":"agente@b2breservas.com.br", ...}
BRANCH_AGENT_MAP=
# opcional: {"5005":"Suporte"} (senão usa o time do agente)
BRANCH_TEAM_MAP=
# opcional: time -> "Área interna" (vazio = padrão Zendesk)
TEAM_AREA_MAP=
DEFAULT_TEAM=Suporte
AGENT_MATCH_BY_NAME=true
DOWNLOAD_RECORDINGS=true
AUDIO_ALLOWED_HOSTS=*.55pbx.com,*.55pbx.com.br
AUDIO_SEND_API_KEY=false
AUDIO_MAX_MB=80
AUDIO_BITRATE=32k
# IPs/CIDRs da 55PBX (vazio = qualquer IP com o segredo)
ALLOWED_IPS=
TRUST_PROXY=true
MAX_BODY_BYTES=262144
TRIGGER_ASSIGN_ON_AGENT_UPDATE=true
TRIGGER_CLOSE_ENABLED=true
TRIGGER_CLOSE_TEAMS=Novos Negócios
TRIGGER_CLOSE_TYPES=ativo
# vazio = {"zd_area_interna":"Novos negócios","zd_novos_negocios":"Prospecção","zd_status":"Resolvido"}
TRIGGER_CLOSE_ATTRS=
TRIGGER_CLOSE_STATUS=resolved
DB_PATH=/data/pbx-bridge.sqlite3
# LGPD: dias que o payload bruto fica guardado (SQLite legado e ops.webhook_inbox) depois de tratado
RETENTION_DAYS=30
LOG_LEVEL=INFO

# ======================================================================= sd-ops (v2)
# Nenhum valor real aqui. Referências de credenciais por tenant ficam em ops.integration_credentials_refs
# (o banco guarda só o NOME da variável de ambiente).
SDOPS_ENV=prod
# banco SEPARADO no Postgres do ServiceDesk (não é o banco do Chatwoot): CREATE DATABASE servicedesk_ops
SDOPS_DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@servicedesk_postgres:5432/servicedesk_ops
# true = aplica as migrations (Alembic, schema ops) ao subir
SDOPS_MIGRATE_ON_START=false
# Redis do ServiceDesk, DB 7 (stream sd:events)
SDOPS_REDIS_URL=redis://:SENHA@servicedesk_redis:6379/7
SDOPS_STREAM_KEY=sd:events
SDOPS_STREAM_MAXLEN=200000
# tenant usado pelo segredo legado WEBHOOK_SECRET e pelo poller
SDOPS_DEFAULT_TENANT=b2b
SDOPS_WORKERS=true
LOG_JSON=true
# fila: tentativas e backoff (s)
INBOX_MAX_ATTEMPTS=8
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_BASE_DELAY_S=15
OUTBOX_MAX_DELAY_S=3600
BREAKER_THRESHOLD=5
BREAKER_COOLDOWN_S=60
# webhook em tempo real: leitura de call_time/call_duration (examples = como nos exemplos oficiais;
# descriptions = como na tabela do manual). VALIDAR com uma ligação real.
PBX_RT_TIME_FIELDS=examples
# call_status -> resultado (JSON). Só "call_attended" é documentado; complete com os valores reais.
CALL_STATUS_MAP=
CALLBACK_OUTCOMES=missed,abandoned_ura,abandoned_queue,after_hours,dropped
CALLBACK_DUE_MIN=60
SL_THRESHOLD_S=20
SL_SHORT_ABANDON_S=5
# gravações: storage privado (local = volume; s3 = MinIO/S3)
SDOPS_STORAGE_BACKEND=local
SDOPS_STORAGE_DIR=/data/recordings
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
RECORDING_INITIAL_DELAY_S=120
RECORDING_MAX_ATTEMPTS=12
RECORDING_MIN_BYTES=1024
RECORDING_MAX_DURATION_S=14400
RECORDING_SHORT_RATIO=0.5
RECORDING_SHORT_RETRIES=2
# >= 32 caracteres (openssl rand -hex 32): assina as URLs temporárias de gravação
RECORDING_URL_SECRET=
RECORDING_URL_TTL_S=300
CHATWOOT_ATTACH_RECORDING=true
# click-to-call (API "Discagem automática para ramal"): live | mock (só SDOPS_ENV=dev) | disabled
PBX_DIAL_MODE=disabled
PBX_DIAL_URL=https://ws.55pbx.com:20500/api/webphone/dial
# pedir ao suporte 55PBX: client_code, api_key e o JWT do cliente
PBX_DIAL_CLIENT_CODE=
PBX_DIAL_API_KEY=
PBX_DIAL_JWT=
PBX_DIAL_TIMEOUT_S=20
PBX_DIAL_PENDING_S=45
# webphone oficial da 55PBX aberto pelo CTI (GET /capabilities -> webphone.url); vazio = botão desabilitado
PBX_WEBPHONE_URL=
# CTI (Dashboard App): origens do sd-console, sessão curta
SDOPS_ALLOWED_ORIGINS=https://helpdesk.ia4co.com
SESSION_IDLE_MIN=30
SESSION_MAX_HOURS=8
SESSION_COOKIE_SECURE=true
AUTH_RATE_LIMIT_PER_MIN=10
# tokens de serviço: só o SHA-256. Perfis prontos: python -m sd_ops new-service-token n8n | qa-pipeline
# (n8n = calls:read tickets:read tickets:write notify:send reconcile:run reports:read; CTI_AUTH.md §3)
SDOPS_SERVICE_TOKENS={}
# protege /sd-ops/metrics (opcional)
SDOPS_METRICS_TOKEN=
URA_RATE_LIMIT_PER_MIN=10
URA_REQUIRE_CALLER_MATCH=true
# variáveis referenciadas por tenant (nomes livres; cadastre com python -m sd_ops seed-tenant ...)
CHATWOOT_API_TOKEN__B2B=
PBX_WEBHOOK_SECRET__B2B=
PBX_WEBHOOK_TOKEN__B2B=
URA_TOKEN__B2B=
