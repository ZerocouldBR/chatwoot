# pbx-bridge: TODAS as opções. Copie para um arquivo fora do git (chmod 600). Nunca commite valores reais.
# false = não processa nada (webhook responde 503, poller parado)
ENABLED=false
CHATWOOT_URL=http://servicedesk_rails:3000
# token do usuário "Integração 55PBX" (provision_55pbx.rb)
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=1
# id da inbox "Telefone (55PBX)"
PBX_INBOX_ID=
# id do usuário de integração (ignora as próprias notas no gatilho de atribuição)
INTEGRATION_USER_ID=
# >= 32 caracteres: openssl rand -hex 32
WEBHOOK_SECRET=
# "secret" da inbox API (assinatura X-Chatwoot-Signature), opcional
CHATWOOT_WEBHOOK_HMAC_SECRET=
PBX_API_URL=https://reportapi02.55pbx.com:50500/api/pbx/reports/metrics
# chave do painel 55PBX (Integrações > Webservice (API))
PBX_API_KEY=
# nome do header: CONFIRMAR com suporte@55pbx.com.br
PBX_API_KEY_HEADER=key
PBX_TZ_OFFSET=-3
POLL_INTERVAL_MIN=10
POLL_LOOKBACK_MIN=180
# JSON {"3855-FILA_SUPORTE_1":"Suporte"} ou "fila=time;fila=time" (vazio = padrão)
QUEUE_TEAM_MAP=
# {"5005":"agente@b2breservas.com.br", ...}
BRANCH_AGENT_MAP=
# opcional: {"5005":"Suporte"} (senão usa o time do agente)
BRANCH_TEAM_MAP=
# opcional: time -> "Área interna" (vazio = padrão Zendesk)
TEAM_AREA_MAP=
DEFAULT_TEAM=Suporte
AGENT_MATCH_BY_NAME=true
DOWNLOAD_RECORDINGS=true
AUDIO_ALLOWED_HOSTS=*.55pbx.com,*.55pbx.com.br
AUDIO_SEND_API_KEY=false
AUDIO_MAX_MB=80
AUDIO_BITRATE=32k
# IPs/CIDRs da 55PBX (vazio = qualquer IP com o segredo)
ALLOWED_IPS=
TRUST_PROXY=true
MAX_BODY_BYTES=262144
TRIGGER_ASSIGN_ON_AGENT_UPDATE=true
TRIGGER_CLOSE_ENABLED=true
TRIGGER_CLOSE_TEAMS=Novos Negócios
TRIGGER_CLOSE_TYPES=ativo
# vazio = {"zd_area_interna":"Novos negócios","zd_novos_negocios":"Prospecção","zd_status":"Resolvido"}
TRIGGER_CLOSE_ATTRS=
TRIGGER_CLOSE_STATUS=resolved
DB_PATH=/data/pbx-bridge.sqlite3
# LGPD: dias que o payload bruto fica no SQLite depois de tratado
RETENTION_DAYS=30
LOG_LEVEL=INFO
