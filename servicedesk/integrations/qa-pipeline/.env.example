# qa-pipeline (ServiceDesk) — exemplo SEM segredos. Copie para um arquivo 600 fora do git.
# Interruptor geral: false = worker dormente (não consome eventos nem processa jobs).
QA_ENABLED=false
APP_ENV=production
TENANT_DEFAULT=b2b
LOG_LEVEL=INFO
PORT=8090

# Banco separado do Chatwoot; schema "qa" com Alembic próprio (qa.alembic_version).
DATABASE_URL=postgresql+psycopg://sd_qa:<senha>@<host>:5432/servicedesk_ops
# Redis DB 7, stream de eventos do projeto (contrato WEBHOOK_CONTRACTS.md §8.2).
REDIS_URL=redis://:<senha>@<host>:6379/7
EVENTS_STREAM=sd:events
CONSUMER_GROUP=qa-pipeline
STREAM_START_ID=0
DLQ_STREAM=sd:events:dlq:qa

# Gravações: volume do sd-ops montado SOMENTE LEITURA (padrão) ou S3/MinIO (pip install boto3).
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/data/recordings
# S3_ENDPOINT= S3_BUCKET= S3_REGION=us-east-1 S3_ACCESS_KEY= S3_SECRET_KEY=
AUDIO_MAX_MB=80
AUDIO_MAX_DURATION_S=7200
AUDIO_WAIT_ATTEMPTS=8

# STT: faster_whisper (local, gratuito, padrão) | openai (externo, pago, exige ALLOW_EXTERNAL_AI) | mock
STT_PROVIDER=faster_whisper
STT_LANGUAGE=pt
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=2
WHISPER_BEAM_SIZE=1
WHISPER_VAD=true
HF_HOME=/models
STT_SPLIT_STEREO=true
# Só preencha se a 55PBX gravar atendente e cliente em canais separados (confirmado com o fornecedor):
# CHANNEL_SPEAKER_MAP=0=atendente,1=cliente
STT_MIN_COVERAGE=0.9
STORE_UNMASKED_TRANSCRIPT=false

# LLM: mock (padrão, regras sem IA) | local (endpoint privado compatível OpenAI: Ollama/vLLM) |
#      openai | anthropic | gemini (externos e pagos: exigem ALLOW_EXTERNAL_AI=true + aprovação de custo/LGPD)
LLM_PROVIDER=mock
# LLM_MODEL=
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_API_KEY=
LLM_TIMEOUT_S=120
LLM_TEMPERATURE=0
ALLOW_EXTERNAL_AI=false
# OPENAI_API_KEY=  (só para STT_PROVIDER=openai)

QA_RUBRIC_CODE=padrao
QA_MIN_APPLICABLE_WEIGHT=50
QA_LOW_SCORE_THRESHOLD=60

# Nota privada "rascunho IA" no Chatwoot (API pública). Token de um usuário agente de integração.
POST_CHATWOOT_NOTES=false
CHATWOOT_URL=http://servicedesk_rails:3000
CHATWOOT_ACCOUNT_ID=1
# CHATWOOT_API_TOKEN=
CONSOLE_BASE_URL=https://helpdesk.ia4co.com/sd-console

# sd-ops (A2): validação da sessão do CTI (/auth/me) e devolução dos resultados (POST /analysis-results).
SD_OPS_URL=http://sd-ops:8080/sd-ops/api/v1
# SD_OPS_SERVICE_TOKEN=sdsvc_...   (escopos calls:read, recordings:read, analysis:write)
AUTH_MODE=sdops
# Tokens de serviço desta API (só SHA-256): python -m qa_pipeline new-service-token n8n b2b qa:read
# QA_SERVICE_TOKENS={"n8n":{"sha256":"...","tenants":["b2b"],"scopes":["qa:read"]}}

MAX_ATTEMPTS=6
RETRY_BASE_S=30
RETRY_MAX_S=3600
WORKER_POLL_S=2
STT_TIMEOUT_S=3600
