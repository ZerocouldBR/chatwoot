          "name": "SD-OPS: token de serviço do n8n (Authorization: Bearer)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "// Resposta em array vira vários itens no n8n; resposta embrulhada ({items|data: [...]}) vira um item.\nconst lista = $('tickets_em_risco').all().map(i => i.json).flatMap(j => Array.isArray(j.items) ? j.items : (Array.isArray(j.data) ? j.data : [j]));\nreturn lista.filter(t => t && (t.ticket_id || t.id) && !t.breached).map(t => ({ json: {\n  ticket_id: t.ticket_id || t.id, protocolo: t.protocol || t.protocolo || '', metric: t.metric || '',\n  due_at: t.due_at || '' } }));\n"
      },
      "id": "d266c908-f627-5dbe-816a-e405559f39aa",
      "name": "um_por_ticket",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        -120
      ]
    },
    {
      "parameters": {
        "jsCode": "const sd = $getWorkflowStaticData('global');\nsd.enviados = sd.enviados || {};\nconst agora = Date.now();\nfor (const [k, t] of Object.entries(sd.enviados)) if (agora - t > 7 * 86400000) delete sd.enviados[k];\nconst out = [];\nfor (const it of $input.all()) {\n  const chave = 'sla:' + it.json.ticket_id + ':' + it.json.metric + ':' + it.json.due_at;\n  if (sd.enviados[chave]) continue;          // já enviado/alertado: não repete\n  sd.enviados[chave] = agora;                // reserva antes do envio (no máximo uma vez)\n  out.push({ json: { ...it.json, chave } });\n}\nreturn out;\n"
      },
