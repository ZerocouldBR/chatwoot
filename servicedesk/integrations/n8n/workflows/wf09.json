          "id": "REPLACE_CRED_SDOPS_SERVICE_TOKEN",
          "name": "SD-OPS: token de serviço do n8n (Authorization: Bearer)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "const r = $('reconcilia').first().json;\n// sd-ops: 202 {rows, new} | 202 {skipped: motivo} | 502 {error, rows, new}\nconst b = r.body || {};\nconst erro = r.statusCode >= 300 || !!b.error;\nconst pulou = !!b.skipped;\nconst per = $('janela').first().json.from + ' a ' + $('janela').first().json.to;\nconst texto = '[WF09] Reconciliação ' + per + ': ' + (erro ? ('FALHOU (HTTP ' + r.statusCode + ') ' + (b.error || '')) :\n  pulou ? ('NÃO EXECUTADA: ' + b.skipped) : ('linhas do Report02 ' + (b.rows || 0) + ', novas (não vistas em tempo real) ' + (b.new || 0)));\n// \"novas\" > 0 = ligações que o tempo real não entregou: alerta só acima do limite configurado\nreturn [{ json: { alertar: erro || pulou || Number(b.new || 0) > $('config').first().json.alerta_novas_acima, texto } }];\n"
      },
