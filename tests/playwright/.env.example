# Playwright Test Configuration

# Base URL for the instance under test (local dev server, or the VPS through the SSH tunnel)
BASE_URL=http://localhost:3000

# Admin credentials for the legacy UI suites
TEST_USER_EMAIL=admin@chatwoot.com
TEST_USER_PASSWORD="Password123@#"

# Ticket suite (project "tickets"): an isolated "E2E Tickets" account is created by global-setup.
E2E_PASSWORD="E2e!Tickets2026"
# How to reach `rails runner` (defaults to `bundle exec rails runner` in the repo root).
# RAILS_RUNNER_CMD='ssh servicedesk-dev "cd /opt/servicedesk-dev && ./dev.sh rails runner"'

# Real test mailboxes for the e-mail scenarios (SUPPORT is connected to the helpdesk inbox).
MAIL_SUPPORT_ADDRESS=
MAIL_SUPPORT_IMAP_HOST=imap.gmail.com
MAIL_SUPPORT_IMAP_PORT=993
MAIL_SUPPORT_SMTP_HOST=smtp.gmail.com
MAIL_SUPPORT_SMTP_PORT=587
MAIL_SUPPORT_USER=
MAIL_SUPPORT_PASSWORD=

