<%
  brand_name = GlobalConfig.get_value('INSTALLATION_NAME').presence || 'Helpdesk'
  brand_logo = GlobalConfig.get_value('LOGO_THUMBNAIL').presence || '/brand-assets/logo_thumbnail.svg'
%>
<div class="flex h-14 shrink-0 items-center gap-3">
  <%= link_to image_tag(brand_logo, alt: "", class: "size-8"), super_admin_root_path, class: "shrink-0", tabindex: -1, aria: { hidden: true } %>
  <div class="min-w-0 whitespace-nowrap">
    <div class="flex items-baseline gap-1.5 leading-5">
      <%= link_to brand_name, super_admin_root_path, class: "text-sm font-medium text-n-slate-12" %>
      <span class="text-label-small tabular-nums text-n-slate-10">v<%= Chatwoot.config[:version] %></span>
    </div>
    <div class="text-label-small leading-4 text-n-slate-10"><%= t("super_admin.navigation.suffix") %></div>
  </div>
</div>
