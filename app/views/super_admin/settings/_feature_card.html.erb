<%# locals: (attrs:, url: nil) -%>
<%= content_tag (url ? :a : :div),
                href: url,
                class: class_names("rounded-xl border border-n-weak bg-n-solid-1 group flex items-center gap-3 p-3.5", "hover:border-n-blue-7 hover:bg-n-blue-2" => url),
                data: { filter_item: true } do %>
  <%= render "icon_tile", icon: attrs['icon'] || 'i-lucide-sliders-horizontal' %>
  <span class="min-w-0 flex-1">
    <span class="flex items-center gap-1.5">
      <span class="truncate text-heading-3 text-n-slate-12"><%= attrs['name'] %></span>
    </span>
    <span class="block truncate text-label-small text-n-slate-11" title="<%= attrs['description'] %>"><%= attrs['description'] || t('super_admin.settings.default_description') %></span>
  </span>
  <% if url %>
    <span class="i-lucide-settings size-4 shrink-0 text-n-slate-9 group-hover:text-n-blue-11" title="<%= t('super_admin.settings.configure') %>"></span>
  <% else %>
    <span class="i-lucide-circle-check size-4 shrink-0 text-n-teal-10" title="<%= t('super_admin.features.enabled') %>"></span>
  <% end %>
<% end %>
